[Unit]
Description=KFaceAuth Standalone Face Authentication Daemon
Documentation=man:kfaceauthd(8)
Requires=kfaceauth.socket
After=kfaceauth.socket local-fs.target systemd-udevd.service

[Service]
Type=exec
ExecStart=/usr/libexec/kfaceauthd
EnvironmentFile=-/etc/kfaceauth/kfaceauth.conf
# The service and vault group are static sysusers accounts. NSS must not merge
# membership from systemd userdb services inside the confined daemon.
Environment=SYSTEMD_BYPASS_USERDB=1
User=kfaceauth
Group=kfaceauth
SupplementaryGroups=video
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=1s

# Hardening & Sandboxing (Gate 4.1 least-privilege)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
# The helper owns system-vault mutations. The daemon only reads vaults and keys.
# The socket unit owns /run/kfaceauth and passes its listener to this service.
ReadOnlyPaths=/var/lib/kfaceauth /usr/share/kfaceauth/models /etc/kfaceauth
DevicePolicy=auto
DeviceAllow=char-video4linux rw
DeviceAllow=/dev/tpmrm0 rw

[Install]
WantedBy=multi-user.target
