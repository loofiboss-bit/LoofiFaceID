module kfaceauth_sddm 1.0.0;

require {
    type kfaceauth_sock_t;
    type init_t;
    type xdm_t;
    class sock_file write;
    class unix_stream_socket connectto;
}

# Grant SDDM access only to the explicitly labeled KFaceAuth socket. Keep
# /run/kfaceauth itself at the platform default label for systemd sandboxing.
allow xdm_t kfaceauth_sock_t:sock_file write;
allow xdm_t init_t:unix_stream_socket connectto;
