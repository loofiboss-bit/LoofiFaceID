<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>KFaceAuth</vendor>
  <vendor_url>https://github.com/loofiboss-bit/LoofiFaceID</vendor_url>

  <action id="org.kde.kfaceauth.manage-vault">
    <description>Provision the system profile and configure an experimental PAM login target</description>
    <description xml:lang="sv">Förbered systemprofilen och ändra ett experimentellt PAM-inloggningsmål</description>
    <message>Administrator authorization is required to configure an experimental login target</message>
    <message xml:lang="sv">Administratörsbehörighet krävs för att ändra ett experimentellt inloggningsmål</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kfaceauth-sync-vault</annotate>
  </action>
</policyconfig>
