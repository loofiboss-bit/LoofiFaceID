diff --git a/src/greeter/theme/FaceAuthenticationControl.qml b/src/greeter/theme/FaceAuthenticationControl.qml
new file mode 100644
index 0000000000000000000000000000000000000000..3b8a2435a2a9a3e8795660a2125d0ab9644382cd
--- /dev/null
+++ b/src/greeter/theme/FaceAuthenticationControl.qml
@@ -0,0 +1,143 @@
+import QtQuick 2.0
+
+Item {
+    id: control
+
+    property bool isPrimaryScreen: primaryScreen
+    property string selectedUser: ""
+    property int sessionIndex: 0
+    property string authenticationMode: "unknown"
+    property int modeRequestId: 0
+    property bool faceActivityPending: false
+
+    width: Math.min(parent ? parent.width - 60 : 280, 280)
+    height: visible ? (status.visible ? 82 : 46) : 0
+    visible: isPrimaryScreen && sddm.faceAuthenticationAvailable && sddm.faceAuthenticationUiReady
+        && (authenticationMode === "manual" || authenticationMode === "on-activity")
+
+    function refreshMode() {
+        authenticationMode = "unknown"
+        if (!isPrimaryScreen || selectedUser.length === 0
+                || !sddm.faceAuthenticationAvailable || !sddm.faceAuthenticationUiReady)
+            return
+        modeRequestId += 1
+        sddm.requestFaceAuthenticationMode(selectedUser, modeRequestId)
+    }
+
+    Component.onCompleted: {
+        sddm.registerFaceAuthenticationUi(1)
+        if (isPrimaryScreen)
+            sddm.setFaceAuthenticationSelectedUser(selectedUser)
+        refreshMode()
+    }
+
+    onSelectedUserChanged: {
+        faceActivityPending = false
+        authenticationMode = "unknown"
+        if (isPrimaryScreen)
+            sddm.setFaceAuthenticationSelectedUser(selectedUser)
+        refreshMode()
+    }
+
+    onSessionIndexChanged: {
+        faceActivityPending = false
+        sddm.suppressFaceAuthenticationActivity()
+        if (sddm.faceAuthenticationActive)
+            sddm.cancelFaceAuthentication()
+    }
+
+    Connections {
+        target: sddm
+        function onFaceAuthenticationModeChanged(user, requestId, mode) {
+            if (control.isPrimaryScreen && user === control.selectedUser
+                    && requestId === control.modeRequestId) {
+                control.authenticationMode = mode
+                if (mode !== "on-activity")
+                    control.faceActivityPending = false
+                else if (control.faceActivityPending && !sddm.faceAuthenticationActive) {
+                    control.faceActivityPending = false
+                    sddm.startFaceAuthentication(control.selectedUser, control.sessionIndex,
+                        sddm.FaceAuthenticationUserActivity)
+                }
+            }
+        }
+        function onFaceAuthenticationActivity() {
+            if (!control.isPrimaryScreen || control.selectedUser.length === 0
+                    || sddm.faceAuthenticationActive)
+                return
+            if (control.authenticationMode === "on-activity")
+                sddm.startFaceAuthentication(control.selectedUser, control.sessionIndex,
+                    sddm.FaceAuthenticationUserActivity)
+            else if (control.authenticationMode === "unknown")
+                control.faceActivityPending = true
+        }
+        function onFaceAuthenticationAvailableChanged(available) {
+            control.refreshMode()
+        }
+        function onFaceAuthenticationUiReadyChanged(ready) {
+            control.refreshMode()
+        }
+    }
+
+    Rectangle {
+        id: button
+        anchors.top: parent.top
+        anchors.horizontalCenter: parent.horizontalCenter
+        width: parent.width
+        height: 46
+        radius: 4
+        color: buttonMouseArea.pressed ? "#666666" : "#444444"
+        activeFocusOnTab: control.visible
+        Accessible.role: Accessible.Button
+        Accessible.name: buttonLabel.text
+        Accessible.description: sddm.faceAuthenticationMessage
+
+        function activate() {
+            sddm.suppressFaceAuthenticationActivity()
+            if (sddm.faceAuthenticationActive) {
+                sddm.cancelFaceAuthentication()
+            } else if (control.selectedUser.length > 0) {
+                sddm.startFaceAuthentication(control.selectedUser, control.sessionIndex,
+                    sddm.FaceAuthenticationExplicitButton)
+            }
+        }
+
+        // Space activates this explicit control. Return stays on password login.
+        Keys.onSpacePressed: activate()
+
+        Text {
+            id: buttonLabel
+            anchors.fill: parent
+            verticalAlignment: Text.AlignVCenter
+            horizontalAlignment: Text.AlignHCenter
+            color: "white"
+            wrapMode: Text.WordWrap
+            text: sddm.faceAuthenticationActive
+                ? qsTr("Use password")
+                : (sddm.faceAuthenticationState === sddm.FaceAuthenticationFailed
+                   || sddm.faceAuthenticationState === sddm.FaceAuthenticationTimedOut
+                   || sddm.faceAuthenticationState === sddm.FaceAuthenticationCanceled
+                   ? qsTr("Try face again") : qsTr("Sign in with face"))
+        }
+
+        MouseArea {
+            id: buttonMouseArea
+            anchors.fill: parent
+            onClicked: button.activate()
+        }
+    }
+
+    Text {
+        id: status
+        anchors.top: button.bottom
+        anchors.topMargin: 8
+        anchors.horizontalCenter: parent.horizontalCenter
+        width: parent.width
+        color: "white"
+        wrapMode: Text.WordWrap
+        text: sddm.faceAuthenticationMessage
+        visible: control.visible && text.length > 0
+        Accessible.role: Accessible.StaticText
+        Accessible.name: text
+    }
+}
