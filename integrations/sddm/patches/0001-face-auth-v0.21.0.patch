+    bool Display::startFaceAuth(const QString &user, const Session &session) {
+        if (!session.isValid()) {
+            qWarning() << "Invalid face-auth session" << session.fileName();
+            return false;
+        }
+        if (session.xdgSessionType().isEmpty() || session.exec().isEmpty()) {
+            qWarning() << "Face-auth session is missing its type or command" << session.fileName();
+            return false;
+        }
+
+        m_faceAuth = new Auth(this);
+        m_faceAuth->setVerbose(true);
+        connect(m_faceAuth, &Auth::requestChanged, this, &Display::slotFaceAuthRequestChanged);
+        connect(m_faceAuth, &Auth::authentication, this, &Display::slotFaceAuthenticationFinished);
+        connect(m_faceAuth, &Auth::sessionStarted, this, &Display::slotFaceSessionStarted);
+        connect(m_faceAuth, &Auth::finished, this, &Display::slotFaceHelperFinished);
+        connect(m_faceAuth, &Auth::info, this, &Display::slotFaceAuthInfo);
+        connect(m_faceAuth, &Auth::error, this, &Display::slotFaceAuthError);
+
+        if (Logind::isAvailable() && mainConfig.Users.ReuseSession.get()) {
+            const quint64 attemptId = m_faceAttemptId;
+            OrgFreedesktopLogin1ManagerInterface manager(Logind::serviceName(), Logind::managerPath(), QDBusConnection::systemBus());
+            auto reply = manager.ListSessions();
+            auto *watcher = new QDBusPendingCallWatcher(reply, this);
+            connect(watcher, &QDBusPendingCallWatcher::finished, this,
+                    [this, watcher, user, session, attemptId] {
+                const QDBusPendingReply<SessionInfoList> finished = *watcher;
+                watcher->deleteLater();
+                if (!m_faceAuthBusy || m_faceAuthCancellationRequested || !m_faceAuth
+                    || attemptId != m_faceAttemptId)
+                    return;
+                if (!finished.isError()) {
+                    const SessionInfoList candidates = finished.value();
+                    auto tryNextCandidate = std::make_shared<std::function<void(int)>>();
+                    const auto getSessionProperty = [](const QString &path, const QString &property) {
+                        QDBusMessage message = QDBusMessage::createMethodCall(
+                            Logind::serviceName(), path,
+                            QStringLiteral("org.freedesktop.DBus.Properties"), QStringLiteral("Get"));
+                        message << QStringLiteral("org.freedesktop.login1.Session") << property;
+                        return QDBusConnection::systemBus().asyncCall(message);
+                    };
+                    *tryNextCandidate = [this, user, session, candidates, tryNextCandidate,
+                                         getSessionProperty, attemptId](int index) {
+                        if (!m_faceAuthBusy || m_faceAuthCancellationRequested || !m_faceAuth
+                            || attemptId != m_faceAttemptId) {
+                            *tryNextCandidate = std::function<void(int)>();
+                            return;
+                        }
+                        if (index >= candidates.size()) {
+                            *tryNextCandidate = std::function<void(int)>();
+                            prepareFaceAuthSession(user, session);
+                            return;
+                        }
+
+                        const SessionInfo entry = candidates.at(index);
+                        if (entry.userName != user) {
+                            (*tryNextCandidate)(index + 1);
+                            return;
+                        }
+
+                        auto *serviceWatcher = new QDBusPendingCallWatcher(
+                            getSessionProperty(entry.sessionPath.path(), QStringLiteral("Service")), this);
+                        connect(serviceWatcher, &QDBusPendingCallWatcher::finished, this,
+                                [this, serviceWatcher, entry, user, session, getSessionProperty,
+                                 tryNextCandidate, index, attemptId] {
+                            const QDBusPendingReply<QDBusVariant> serviceReply = *serviceWatcher;
+                            serviceWatcher->deleteLater();
+                            if (!m_faceAuthBusy || m_faceAuthCancellationRequested || !m_faceAuth
+                                || attemptId != m_faceAttemptId) {
+                                *tryNextCandidate = std::function<void(int)>();
+                                return;
+                            }
+                            if (serviceReply.isError()
+                                || serviceReply.value().variant().toString() != QLatin1String("sddm")) {
+                                (*tryNextCandidate)(index + 1);
+                                return;
+                            }
+
+                            auto *stateWatcher = new QDBusPendingCallWatcher(
+                                getSessionProperty(entry.sessionPath.path(), QStringLiteral("State")), this);
+                            connect(stateWatcher, &QDBusPendingCallWatcher::finished, this,
+                                    [this, stateWatcher, entry, user, session,
+                                     tryNextCandidate, index, attemptId] {
+                                const QDBusPendingReply<QDBusVariant> stateReply = *stateWatcher;
+                                stateWatcher->deleteLater();
+                                if (!m_faceAuthBusy || m_faceAuthCancellationRequested || !m_faceAuth
+                                    || attemptId != m_faceAttemptId) {
+                                    *tryNextCandidate = std::function<void(int)>();
+                                    return;
+                                }
+                                if (!stateReply.isError()
+                                    && stateReply.value().variant().toString() == QLatin1String("online")) {
+                                    m_faceReuseSessionId = entry.sessionId;
+                                    *tryNextCandidate = std::function<void(int)>();
+                                    prepareFaceAuthSession(user, session);
+                                    return;
+                                }
+                                (*tryNextCandidate)(index + 1);
+                            });
+                        });
+                    };
+                    (*tryNextCandidate)(0);
+                    return;
+                }
+                prepareFaceAuthSession(user, session);
+            });
+            return true;
+        }
+
+        prepareFaceAuthSession(user, session);
+        return true;
+    }
+
+    void Display::prepareFaceAuthSession(const QString &user, const Session &session) {
+        if (!m_faceAuthBusy || m_faceAuthCancellationRequested || !m_faceAuth)
+            return;
+
+        m_faceSessionName = session.fileName();
+        m_faceSessionTerminalId = m_terminalId;
+        if ((session.type() == Session::WaylandSession && m_displayServerType == X11DisplayServerType)
+            || (m_greeter->isRunning() && m_displayServerType != X11DisplayServerType)) {
+            m_faceSessionTerminalId = VirtualTerminal::setUpNewVt();
+        }
+
+        QProcessEnvironment env;
+        env.insert(session.additionalEnv());
+        env.insert(QStringLiteral("PATH"), mainConfig.Users.DefaultPath.get());
+        env.insert(QStringLiteral("XDG_SEAT_PATH"), daemonApp->displayManager()->seatPath(seat()->name()));
+        env.insert(QStringLiteral("XDG_SESSION_PATH"), daemonApp->displayManager()->sessionPath(QStringLiteral("Session%1").arg(daemonApp->newSessionId())));
+        env.insert(QStringLiteral("DESKTOP_SESSION"), session.desktopSession());
+        if (!session.desktopNames().isEmpty())
+            env.insert(QStringLiteral("XDG_CURRENT_DESKTOP"), session.desktopNames());
+        env.insert(QStringLiteral("XDG_SESSION_CLASS"), QStringLiteral("user"));
+        env.insert(QStringLiteral("XDG_SESSION_TYPE"), session.xdgSessionType());
+        env.insert(QStringLiteral("XDG_SEAT"), seat()->name());
+        env.insert(QStringLiteral("XDG_VTNR"), QString::number(m_faceSessionTerminalId));
+#ifdef HAVE_SYSTEMD
+        env.insert(QStringLiteral("XDG_SESSION_DESKTOP"), session.desktopNames());
+#endif
+
+        if (session.xdgSessionType() == QLatin1String("x11")) {
+            if (m_displayServerType == X11DisplayServerType)
+                env.insert(QStringLiteral("DISPLAY"), name());
+            else
+                m_faceAuth->setDisplayServerCommand(XorgUserDisplayServer::command(this));
+        } else {
+            m_faceAuth->setDisplayServerCommand(QStringLiteral());
+        }
+
+        if (m_faceReuseSessionId.isNull())
+            m_faceAuth->setSession(session.exec());
+        m_faceAuth->setUser(user);
+        m_faceAuth->setFaceAuthentication(true);
+        m_faceAuth->insertEnvironment(env);
+        m_faceAuth->start();
+    }
+
+    void Display::slotFaceAuthRequestChanged() {
+        if (!m_faceAuth || !m_faceAuthBusy || m_faceAuthCancellationRequested)
+            return;
+        if (m_faceAuth->request()->prompts().isEmpty())
+            return;
+
+        cancelFaceAuthentication(FaceAuthenticationState::Failed,
+                                 tr("Face sign-in requested a password. Use the password field instead."));
+    }
+
+    void Display::slotFaceAuthenticationFinished(const QString &user, bool success) {
+        if (m_faceAuthCancellationRequested || !m_faceAuthBusy)
+            return;
+        const struct passwd *authenticatedAccount = getpwnam(qPrintable(user));
+        if (success && (user != m_faceUser || !authenticatedAccount
+            || static_cast<quint64>(authenticatedAccount->pw_uid) != m_faceUserUid)) {
+            cancelFaceAuthentication(FaceAuthenticationState::Failed,
+                                     tr("Face authentication returned a different user. Use password or try again."));
+            return;
+        }
+        if (!success) {
+            m_faceAuthDeadline.stop();
+            setFaceAuthenticationStatus(FaceAuthenticationState::Failed,
+                                        tr("Face not recognized. Use password or try again."));
+            return;
+        }
+
+        m_faceAuthDeadline.stop();
+        m_faceAuthenticationAccepted = true;
+        setFaceAuthenticationStatus(FaceAuthenticationState::Accepted,
+                                    tr("Face accepted. Starting session…"));
+
+        if (!m_faceReuseSessionId.isNull()) {
+            OrgFreedesktopLogin1ManagerInterface manager(Logind::serviceName(), Logind::managerPath(), QDBusConnection::systemBus());
+            manager.UnlockSession(m_faceReuseSessionId);
+            manager.ActivateSession(m_faceReuseSessionId);
+            m_started = true;
+        } else if (qobject_cast<XorgDisplayServer *>(m_displayServer)) {
+            m_faceAuth->setCookie(qobject_cast<XorgDisplayServer *>(m_displayServer)->cookie());
+        }
+
+        if (mainConfig.Users.RememberLastUser.get())
+            stateConfig.Last.User.set(user);
+        else
+            stateConfig.Last.User.setDefault();
+        if (mainConfig.Users.RememberLastSession.get())
+            stateConfig.Last.Session.set(m_faceSessionName);
+        else
+            stateConfig.Last.Session.setDefault();
+        stateConfig.save();
+
+        if (m_faceSocket)
+            m_socketServer->loginSucceeded(m_faceSocket);
+        m_faceSocket = nullptr;
+    }
+
+    void Display::slotFaceSessionStarted(bool success) {
+        qDebug() << "Face-auth session started" << success;
+    }
+
+    void Display::slotFaceHelperFinished(Auth::HelperExitStatus status) {
+        const bool authenticationAccepted = m_faceAuthenticationAccepted;
+        m_faceAuthDeadline.stop();
+        if (!m_faceAuthenticationAccepted
+            && m_faceAuthState != FaceAuthenticationState::Failed
+            && m_faceAuthState != FaceAuthenticationState::Canceled
+            && m_faceAuthState != FaceAuthenticationState::TimedOut) {
+            setFaceAuthenticationStatus(FaceAuthenticationState::Failed,
+                                        tr("Face sign-in failed. Use password or try again."));
+        }
+
+        m_faceAuthBusy = false;
+        m_faceAuthCancellationRequested = false;
+        m_faceAuthenticationAccepted = false;
+        m_faceSocket = nullptr;
+        if (m_faceAuth) {
+            m_faceAuth->deleteLater();
+            m_faceAuth = nullptr;
+        }
+
+        if (authenticationAccepted && status != Auth::HELPER_AUTH_ERROR)
+            stop();
+    }
+
+    void Display::slotFaceAuthInfo(const QString &message, Auth::Info info) {
+        Q_UNUSED(info);
+        if (!m_faceAuthBusy || m_faceAuthCancellationRequested)
+            return;
+
+        const QString token = message.trimmed();
+        if (token == QLatin1String("starting-camera")) {
+            setFaceAuthenticationStatus(FaceAuthenticationState::StartingCamera,
+                                        tr("Starting camera…"));
+        } else if (token == QLatin1String("looking-for-face")) {
+            setFaceAuthenticationStatus(FaceAuthenticationState::LookingForFace,
+                                        tr("Look at the camera."));
+        } else if (token == QLatin1String("use-password")) {
+            cancelFaceAuthentication(FaceAuthenticationState::Failed,
+                                     tr("Face not recognized. Use password or try again."));
+        }
+    }
+
+    void Display::slotFaceAuthError(const QString &message, Auth::Error error) {
+        qWarning() << "Face authentication error:" << error << message;
+        if (!m_faceAuthBusy || m_faceAuthCancellationRequested || m_faceAuthenticationAccepted)
+            return;
+        if (error == Auth::ERROR_AUTHENTICATION) {
+            m_faceAuthDeadline.stop();
+            setFaceAuthenticationStatus(FaceAuthenticationState::Failed,
+                                        tr("Face sign-in failed. Use password or try again."));
+        }
+    }
+
