+    void Display::faceAuthenticationModeRequested(QLocalSocket *socket, quint64 requestId,
+                                                  const QString &user) {
+        const struct passwd *account = user.isEmpty() || user == QLatin1String("sddm")
+            ? nullptr : getpwnam(qPrintable(user));
+        if (!socket || requestId == 0 || !m_faceAuthenticationAvailable
+            || !m_socketServer->faceAuthenticationUiReady(socket) || !account) {
+            if (socket && requestId != 0)
+                m_socketServer->faceAuthenticationMode(socket, requestId, user, QStringLiteral("unknown"));
+            return;
+        }
+
+        const QPointer<QLocalSocket> clientSocket(socket);
+        queryFaceAuthenticationMode(static_cast<quint64>(account->pw_uid),
+            [this, clientSocket, requestId, user](const QString &mode) {
+            if (clientSocket && m_socketServer)
+                m_socketServer->faceAuthenticationMode(clientSocket, requestId, user, mode);
+        });
+    }
+
+    QProcess *Display::queryFaceAuthenticationMode(
+        quint64 uidValue, std::function<void(const QString &)> callback) {
+        struct CompletionState {
+            bool completed { false };
+        };
+
+        const QString uid = QString::number(uidValue);
+        auto *process = new QProcess(this);
+        auto *timeout = new QTimer(process);
+        auto completed = std::make_shared<CompletionState>();
+        timeout->setSingleShot(true);
+
+        const auto complete = [process, timeout, completed, callback](const QString &mode) {
+            if (completed->completed)
+                return;
+            completed->completed = true;
+            timeout->stop();
+            callback(mode);
+            process->deleteLater();
+        };
+
+        connect(process, &QProcess::finished, this,
+                [process, complete](int exitCode, QProcess::ExitStatus exitStatus) {
+            const QByteArray output = process->readAllStandardOutput();
+            QString mode = QStringLiteral("unknown");
+            if (exitCode == 0 && exitStatus == QProcess::NormalExit) {
+                if (output == QByteArrayLiteral("mode=off\n"))
+                    mode = QStringLiteral("off");
+                else if (output == QByteArrayLiteral("mode=manual\n"))
+                    mode = QStringLiteral("manual");
+                else if (output == QByteArrayLiteral("mode=on-activity\n"))
+                    mode = QStringLiteral("on-activity");
+            }
+            complete(mode);
+        });
+        connect(process, &QProcess::errorOccurred, this,
+                [complete](QProcess::ProcessError error) {
+            if (error == QProcess::FailedToStart)
+                complete(QStringLiteral("unknown"));
+        });
+        connect(timeout, &QTimer::timeout, process, [process, complete] {
+            process->kill();
+            complete(QStringLiteral("unknown"));
+        });
+
+        const QString program = QStringLiteral("/usr/libexec/kfaceauth-policy");
+        const QStringList arguments {QStringLiteral("--get"), QStringLiteral("--uid"), uid,
+                                     QStringLiteral("--target"), QStringLiteral("sddm")};
+        QTimer::singleShot(0, process, [process, timeout, program, arguments] {
+            process->start(program, arguments);
+            timeout->start(400);
+        });
+        return process;
+    }
+
+    void Display::faceLogin(QLocalSocket *socket, quint64 attemptId,
+                            const QString &user, const Session &session,
+                            FaceAuthenticationTrigger trigger) {
+        const struct passwd *account = user.isEmpty() || user == QLatin1String("sddm")
+            ? nullptr : getpwnam(qPrintable(user));
+        if (!socket || attemptId == 0 || !m_faceAuthenticationAvailable
+            || !m_socketServer->faceAuthenticationUiReady(socket)
+            || !account || m_faceAuthBusy || m_faceAuthenticationAccepted) {
+            if (socket && attemptId != 0)
+                m_socketServer->faceAuthenticationStatus(
+                    socket, attemptId, FaceAuthenticationState::Unavailable,
+                    tr("Face sign-in is unavailable. Use your password."));
+            return;
+        }
+
+        m_faceSocket = socket;
+        m_faceAttemptId = attemptId;
+        m_faceUser = user;
+        m_faceUserUid = static_cast<quint64>(account->pw_uid);
+        m_faceAuthTrigger = trigger;
+        m_faceAuthBusy = true;
+        m_faceAuthCancellationRequested = false;
+        m_faceAuthenticationAccepted = false;
+        m_faceReuseSessionId.clear();
+        m_faceAuthDeadline.start(2000);
+        setFaceAuthenticationStatus(FaceAuthenticationState::StartingCamera,
+                                    tr("Preparing face sign-in…"));
+
+        const quint64 expectedAttemptId = attemptId;
+        m_facePolicyProcess = queryFaceAuthenticationMode(m_faceUserUid,
+            [this, expectedAttemptId, user, session](const QString &mode) {
+                if (m_faceAttemptId != expectedAttemptId || !m_faceAuthBusy
+                    || m_faceAuthCancellationRequested)
+                    return;
+                m_facePolicyProcess = nullptr;
+                const bool allowed = m_faceAuthTrigger == FaceAuthenticationTrigger::UserActivity
+                    ? mode == QLatin1String("on-activity")
+                    : mode == QLatin1String("manual") || mode == QLatin1String("on-activity");
+                if (!allowed) {
+                    m_faceAuthDeadline.stop();
+                    m_faceAuthBusy = false;
+                    setFaceAuthenticationStatus(mode == QLatin1String("unknown")
+                                                   ? FaceAuthenticationState::Unavailable
+                                                   : FaceAuthenticationState::Failed,
+                                               tr("Face sign-in is disabled for this user or the policy could not be read."));
+                    return;
+                }
+                if (!startFaceAuth(user, session)) {
+                    m_faceAuthDeadline.stop();
+                    m_faceAuthBusy = false;
+                    setFaceAuthenticationStatus(FaceAuthenticationState::Failed,
+                                                tr("Face sign-in could not start. Use your password or try again."));
+                }
+            });
+    }
+
+    void Display::cancelFaceLogin(QLocalSocket *socket, quint64 attemptId) {
+        if (!m_faceAuthBusy || m_faceAuthenticationAccepted || socket != m_faceSocket
+            || (attemptId != 0 && attemptId != m_faceAttemptId))
+            return;
+        cancelFaceAuthentication(FaceAuthenticationState::Canceled,
+                                 tr("Use password or try again."));
+    }
+
+    void Display::cancelFaceAuthentication(FaceAuthenticationState state, const QString &message) {
+        if (!m_faceAuthBusy || m_faceAuthenticationAccepted || m_faceAuthCancellationRequested)
+            return;
+
+        m_faceAuthCancellationRequested = true;
+        m_faceAuthDeadline.stop();
+        setFaceAuthenticationStatus(state, message);
+        if (m_facePolicyProcess) {
+            QProcess *process = m_facePolicyProcess;
+            m_facePolicyProcess = nullptr;
+            process->kill();
+            process->deleteLater();
+            m_faceAuthBusy = false;
+            m_faceAuthCancellationRequested = false;
+        } else if (m_faceAuth && m_faceAuth->isActive()) {
+            m_faceAuth->cancel();
+        } else {
+            m_faceAuthBusy = false;
+            if (m_faceAuth) {
+                m_faceAuth->deleteLater();
+                m_faceAuth = nullptr;
+            }
+            m_faceAuthCancellationRequested = false;
+        }
+    }
+
+    void Display::setFaceAuthenticationStatus(FaceAuthenticationState state, const QString &message) {
+        m_faceAuthState = state;
+        if (m_faceSocket && m_faceAttemptId != 0)
+            m_socketServer->faceAuthenticationStatus(m_faceSocket, m_faceAttemptId, state, message);
+    }
