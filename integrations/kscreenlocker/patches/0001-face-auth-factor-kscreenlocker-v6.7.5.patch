+++ b/greeter/facepamauthenticator.h
@@ -0,0 +1,102 @@
+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#pragma once
+
+#include <QObject>
+#include <QProcess>
+#include <QSet>
+#include <QTimer>
+
+class FacePamAuthenticator final : public QObject
+{
+    Q_OBJECT
+
+    Q_PROPERTY(bool busy READ isBusy NOTIFY busyChanged)
+    Q_PROPERTY(bool available READ isAvailable NOTIFY availableChanged)
+    Q_PROPERTY(bool canStart READ canStart NOTIFY canStartChanged)
+    Q_PROPERTY(bool unlocked READ isUnlocked NOTIFY succeeded)
+    Q_PROPERTY(State state READ state NOTIFY stateChanged)
+    Q_PROPERTY(QString policyMode READ policyMode NOTIFY policyModeChanged)
+
+public:
+    enum State {
+        Idle,
+        Starting,
+        CameraStarting,
+        LookingForFace,
+        UsePassword,
+        Failed,
+        TimedOut,
+        Cancelled,
+        Succeeded,
+        CameraBusy,
+        ServiceUnavailable,
+        RetryLater,
+    };
+    Q_ENUM(State)
+
+    enum InterfaceVersion {
+        InterfaceV1 = 1,
+    };
+    Q_ENUM(InterfaceVersion)
+
+    explicit FacePamAuthenticator(QString user, QString workerPath, QString policyHelperPath, quint32 policyUid, QObject *parent = nullptr);
+    ~FacePamAuthenticator() override;
+
+    bool isBusy() const;
+    bool isAvailable() const;
+    bool canStart() const;
+    bool isUnlocked() const;
+    State state() const;
+    QString policyMode() const;
+
+    Q_INVOKABLE void startAttempt();
+    Q_INVOKABLE void cancel();
+    Q_INVOKABLE bool registerThemeComponent(QObject *component, int interfaceVersion);
+    Q_INVOKABLE void notifyUserActivity();
+    Q_INVOKABLE void resetActivityCycle();
+
+Q_SIGNALS:
+    void availableChanged();
+    void busyChanged();
+    void canStartChanged();
+    void stateChanged();
+    void policyModeChanged();
+    void succeeded();
+
+private:
+    void setState(State state);
+    void readStatus(QProcess *process);
+    void finishProcess(QProcess *process, int exitCode, QProcess::ExitStatus exitStatus);
+    void terminateProcess();
+    void startPolicyLookup();
+    void readPolicyOutput(QProcess *process);
+    void finishPolicyLookup(QProcess *process, int exitCode, QProcess::ExitStatus exitStatus);
+    void setPolicyMode(const QString &mode);
+    void schedulePendingActivityAttempt();
+
+    const QString m_user;
+    const QString m_workerPath;
+    const QString m_policyHelperPath;
+    const quint32 m_policyUid;
+    QSet<QObject *> m_themeComponents;
+    QProcess *m_process = nullptr;
+    QProcess *m_policyProcess = nullptr;
+    QTimer m_attemptDeadline;
+    QTimer m_killDeadline;
+    QTimer m_policyDeadline;
+    QTimer m_activityDeadline;
+    QByteArray m_statusBuffer;
+    QByteArray m_policyOutput;
+    QString m_policyMode = QStringLiteral("unknown");
+    State m_state = Idle;
+    bool m_cancelRequested = false;
+    bool m_unlocked = false;
+    bool m_policyReady = false;
+    bool m_policyRejected = false;
+    bool m_activityAttemptConsumed = false;
+    bool m_pendingActivityAttempt = false;
+    bool m_activityDispatchScheduled = false;
+};
diff --git a/greeter/facepamstatus.h b/greeter/facepamstatus.h
new file mode 100644
index 0000000..d1e93c6
--- /dev/null
+++ b/greeter/facepamstatus.h
@@ -0,0 +1,25 @@
+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#pragma once
+#include <cstring>
+#include <initializer_list>
+
+inline const char *facePamStatusToken(const char *message)
+{
+    if (message == nullptr) {
+        return nullptr;
+    }
+    if (std::strcmp(message, "KFACEAUTH_STATUS=starting-camera") == 0) {
+        return "camera-starting";
+    }
+    for (const char *token : {"looking-for-face", "use-password", "camera-busy", "timeout", "service-unavailable", "retry-later"}) {
+        const char *prefix = "KFACEAUTH_STATUS=";
+        const auto length = std::strlen(prefix);
+        if (std::strncmp(message, prefix, length) == 0 && std::strcmp(message + length, token) == 0) {
+            return token;
+        }
+    }
+    return nullptr;
+}
diff --git a/greeter/facepamworker.cpp b/greeter/facepamworker.cpp
new file mode 100644
index 0000000..e4765d2
--- /dev/null
+++ b/greeter/facepamworker.cpp
@@ -0,0 +1,89 @@
+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#include <security/pam_appl.h>
+#include "facepamstatus.h"
+
+#include <pwd.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+int writeTypedStatus(const char *message)
+{
+    const char *token = facePamStatusToken(message);
+    if (token == nullptr) {
+        return 0;
+    }
+    return std::fprintf(stdout, "%s\n", token) < 0 || std::fflush(stdout) != 0 ? -1 : 0;
+}
+
+int converse(int count, const struct pam_message **messages, struct pam_response **responses, void *)
+{
+    if (count <= 0 || count > 16 || messages == nullptr || responses == nullptr) {
+        return PAM_CONV_ERR;
+    }
+    *responses = static_cast<struct pam_response *>(std::calloc(static_cast<size_t>(count), sizeof(struct pam_response)));
+    if (*responses == nullptr) {
+        return PAM_BUF_ERR;
+    }
+    for (int index = 0; index < count; ++index) {
+        if (messages[index] == nullptr || messages[index]->msg == nullptr) {
+            std::free(*responses);
+            *responses = nullptr;
+            return PAM_CONV_ERR;
+        }
+        switch (messages[index]->msg_style) {
+        case PAM_TEXT_INFO:
+            if (writeTypedStatus(messages[index]->msg) != 0) {
+                std::free(*responses);
+                *responses = nullptr;
+                return PAM_CONV_ERR;
+            }
+            break;
+        case PAM_ERROR_MSG:
+            // Do not forward PAM's arbitrary text into the greeter UI.
+            break;
+        case PAM_PROMPT_ECHO_OFF:
+        case PAM_PROMPT_ECHO_ON:
+        default:
+            std::free(*responses);
+            *responses = nullptr;
+            return PAM_CONV_ERR;
+        }
+    }
+    return PAM_SUCCESS;
+}
+} // namespace
+
+int main(int argc, char **argv)
+{
+    if (argc != 2 || argv[1] == nullptr || argv[1][0] == '\0' || getuid() != geteuid()) {
+        return 2;
+    }
+    const struct passwd *account = getpwnam(argv[1]);
+    if (account == nullptr || account->pw_uid != getuid()) {
+        return 2;
+    }
+
+    const struct pam_conv conversation = {converse, nullptr};
+    pam_handle_t *handle = nullptr;
+    int result = pam_start(KSCREENLOCKER_PAM_FACE_SERVICE, argv[1], &conversation, &handle);
+    if (result == PAM_SUCCESS) {
+        result = pam_authenticate(handle, 0);
+        if (result == PAM_SUCCESS) {
+            result = pam_acct_mgmt(handle, 0);
+        }
+        if (result == PAM_SUCCESS) {
+            result = pam_setcred(handle, PAM_REFRESH_CRED);
+        }
+        (void)pam_end(handle, result);
+    }
+    return result == PAM_SUCCESS ? 0 : 1;
+}
