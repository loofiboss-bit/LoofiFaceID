+/*
+SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.kirigami 2.20 as Kirigami
+import org.kde.plasma.components 3.0 as PlasmaComponents3
+import org.kde.kscreenlocker 1.0 as ScreenLocker
+
+Item {
+    id: root
+
+    signal usePasswordRequested()
+
+    visible: faceAuthenticator.available
+    implicitWidth: controls.implicitWidth
+    implicitHeight: controls.implicitHeight
+
+    Component.onCompleted: faceAuthenticator.registerThemeComponent(root, ScreenLocker.FaceAuthenticator.InterfaceV1)
+
+    ColumnLayout {
+        id: controls
+        anchors.fill: parent
+        spacing: Kirigami.Units.smallSpacing
+
+        PlasmaComponents3.Label {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            visible: faceAuthenticator.state !== ScreenLocker.FaceAuthenticator.Idle
+            text: {
+                switch (faceAuthenticator.state) {
+                case ScreenLocker.FaceAuthenticator.Starting:
+                    return i18nd("kscreenlocker_greet", "Starting face authentication…");
+                case ScreenLocker.FaceAuthenticator.CameraStarting:
+                    return i18nd("kscreenlocker_greet", "Starting camera…");
+                case ScreenLocker.FaceAuthenticator.LookingForFace:
+                    return i18nd("kscreenlocker_greet", "Look at the camera…");
+                case ScreenLocker.FaceAuthenticator.CameraBusy:
+                    return i18nd("kscreenlocker_greet", "Camera is busy. Use password or try again.");
+                case ScreenLocker.FaceAuthenticator.ServiceUnavailable:
+                    return i18nd("kscreenlocker_greet", "Face authentication is unavailable. Use password or try again.");
+                case ScreenLocker.FaceAuthenticator.RetryLater:
+                    return i18nd("kscreenlocker_greet", "Try again later or use password.");
+                case ScreenLocker.FaceAuthenticator.TimedOut:
+                    return i18nd("kscreenlocker_greet", "Face authentication timed out. Use password or try again.");
+                case ScreenLocker.FaceAuthenticator.UsePassword:
+                    return i18nd("kscreenlocker_greet", "Use your password or try again.");
+                case ScreenLocker.FaceAuthenticator.Failed:
+                case ScreenLocker.FaceAuthenticator.Cancelled:
+                    return i18nd("kscreenlocker_greet", "Use your password or try again.");
+                default:
+                    return "";
+                }
+            }
+        }
+
+        RowLayout {
+            Layout.alignment: Qt.AlignHCenter
+            spacing: Kirigami.Units.smallSpacing
+
+            PlasmaComponents3.Button {
+                enabled: faceAuthenticator.busy || faceAuthenticator.canStart
+                text: faceAuthenticator.busy
+                    ? i18nd("kscreenlocker_greet", "Cancel face check")
+                    : (faceAuthenticator.state === ScreenLocker.FaceAuthenticator.Failed
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.UsePassword
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.TimedOut
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.CameraBusy
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.ServiceUnavailable
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.RetryLater
+                       || faceAuthenticator.state === ScreenLocker.FaceAuthenticator.Cancelled
+                       ? i18nd("kscreenlocker_greet", "Try Face ID again")
+                       : i18nd("kscreenlocker_greet", "Use Face ID"))
+                icon.name: faceAuthenticator.busy ? "process-stop" : "camera-web"
+                onClicked: {
+                    if (faceAuthenticator.busy) {
+                        faceAuthenticator.cancel();
+                    } else {
+                        faceAuthenticator.startAttempt();
+                    }
+                }
+                Keys.onEscapePressed: faceAuthenticator.cancel()
+            }
+
+            PlasmaComponents3.Button {
+                text: i18nd("kscreenlocker_greet", "Use password")
+                onClicked: {
+                    faceAuthenticator.cancel();
+                    root.usePasswordRequested();
+                }
+                Keys.onEscapePressed: faceAuthenticator.cancel()
+            }
+        }
+    }
+}
