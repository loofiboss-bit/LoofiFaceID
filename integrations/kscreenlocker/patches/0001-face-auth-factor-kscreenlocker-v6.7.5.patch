+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+int main(int argc, char **argv)
+{
+    if (argc != 6 || std::strcmp(argv[1], "--get") != 0 || std::strcmp(argv[2], "--uid") != 0 || std::strcmp(argv[4], "--target") != 0
+        || std::strcmp(argv[5], "plasma-lock") != 0) {
+        return 2;
+    }
+
+    char *end = nullptr;
+    const unsigned long uid = std::strtoul(argv[3], &end, 10);
+    if (end == argv[3] || *end != '\0') {
+        return 2;
+    }
+
+    switch (uid) {
+    case 1001:
+        std::fputs("mode=off\n", stdout);
+        return 0;
+    case 1002:
+        std::fputs("mode=manual\n", stdout);
+        return 0;
+    case 1003:
+        std::fputs("mode=on-activity\n", stdout);
+        return 0;
+    case 1004:
+        std::fputs("mode=on-activity\nextra\n", stdout);
+        return 0;
+    case 1005:
+        std::fputs("mode=manual\n", stdout);
+        return 1;
+    case 1006:
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        std::fputs("mode=on-activity\n", stdout);
+        return 0;
+    case 1007:
+        std::this_thread::sleep_for(std::chrono::milliseconds(75));
+        std::fputs("mode=on-activity\n", stdout);
+        return 0;
+    default:
+        std::fputs("mode=invalid\n", stdout);
+        return 0;
+    }
+}
diff --git a/greeter/facepamauthenticator.cpp b/greeter/facepamauthenticator.cpp
new file mode 100644
index 0000000..90f1d2b
--- /dev/null
+++ b/greeter/facepamauthenticator.cpp
@@ -0,0 +1,465 @@
+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+*/
+#include "facepamauthenticator.h"
+
+#include <QFileInfo>
+#include <QProcessEnvironment>
+#include <QSet>
+
+#include <chrono>
+#include <utility>
+
+using namespace std::chrono_literals;
+
+namespace
+{
+constexpr auto attemptLimit = 2000ms;
+constexpr auto terminateGrace = 100ms;
+constexpr auto maximumStatusBuffer = 256;
+constexpr auto policyLookupLimit = 250ms;
+constexpr auto maximumPolicyOutput = 64;
+}
+
+FacePamAuthenticator::FacePamAuthenticator(QString user, QString workerPath, QString policyHelperPath, quint32 policyUid, QObject *parent)
+    : QObject(parent)
+    , m_user(std::move(user))
+    , m_workerPath(std::move(workerPath))
+    , m_policyHelperPath(std::move(policyHelperPath))
+    , m_policyUid(policyUid)
+{
+    m_attemptDeadline.setSingleShot(true);
+    m_killDeadline.setSingleShot(true);
+    m_policyDeadline.setSingleShot(true);
+    m_activityDeadline.setSingleShot(true);
+    connect(&m_attemptDeadline, &QTimer::timeout, this, [this] {
+        if (!m_process) {
+            return;
+        }
+        m_cancelRequested = true;
+        m_unlocked = false;
+        setState(TimedOut);
+        terminateProcess();
+    });
+    connect(&m_killDeadline, &QTimer::timeout, this, [this] {
+        if (m_process && m_process->state() != QProcess::NotRunning) {
+            m_process->kill();
+        }
+    });
+    connect(&m_policyDeadline, &QTimer::timeout, this, [this] {
+        if (!m_policyProcess) {
+            return;
+        }
+        m_policyRejected = true;
+        setPolicyMode(QStringLiteral("unknown"));
+        if (m_policyProcess->state() != QProcess::NotRunning) {
+            m_policyProcess->kill();
+        }
+    });
+    connect(&m_activityDeadline, &QTimer::timeout, this, [this] {
+        m_pendingActivityAttempt = false;
+    });
+    startPolicyLookup();
+}
+
+FacePamAuthenticator::~FacePamAuthenticator()
+{
+    m_attemptDeadline.stop();
+    m_killDeadline.stop();
+    m_policyDeadline.stop();
+    m_activityDeadline.stop();
+    if (m_process && m_process->state() != QProcess::NotRunning) {
+        m_process->kill();
+        m_process->waitForFinished(100);
+    }
+    if (m_policyProcess && m_policyProcess->state() != QProcess::NotRunning) {
+        m_policyProcess->kill();
+        m_policyProcess->waitForFinished(100);
+    }
+}
+
+bool FacePamAuthenticator::isBusy() const
+{
+    return m_process != nullptr;
+}
+
+bool FacePamAuthenticator::isAvailable() const
+{
+    return m_policyReady && (m_policyMode == QLatin1String("manual") || m_policyMode == QLatin1String("on-activity")) && !m_themeComponents.isEmpty()
+        && !m_workerPath.isEmpty() && QFileInfo(m_workerPath).isExecutable();
+}
+
+bool FacePamAuthenticator::canStart() const
+{
+    return isAvailable() && m_process == nullptr && !m_unlocked;
+}
+
+bool FacePamAuthenticator::isUnlocked() const
+{
+    return m_unlocked;
+}
+
+FacePamAuthenticator::State FacePamAuthenticator::state() const
+{
+    return m_state;
+}
+
+QString FacePamAuthenticator::policyMode() const
+{
+    return m_policyMode;
+}
+
+void FacePamAuthenticator::startAttempt()
+{
+    if (!canStart() || m_user.isEmpty() || m_workerPath.isEmpty()) {
+        return;
+    }
+
+    m_pendingActivityAttempt = false;
+    m_activityDeadline.stop();
+    auto *process = new QProcess(this);
+    m_process = process;
+    m_statusBuffer.clear();
+    m_cancelRequested = false;
+    m_unlocked = false;
+    setState(Starting);
+    Q_EMIT busyChanged();
+    Q_EMIT canStartChanged();
+
+    process->setProgram(m_workerPath);
+    process->setArguments({m_user});
+    process->setProcessChannelMode(QProcess::SeparateChannels);
+    QProcessEnvironment environment;
+    environment.insert(QStringLiteral("LANG"), QStringLiteral("C"));
+    environment.insert(QStringLiteral("LC_ALL"), QStringLiteral("C"));
+    environment.insert(QStringLiteral("PATH"), QStringLiteral("/usr/bin:/bin"));
+    process->setProcessEnvironment(environment);
+
+    connect(process, &QProcess::readyReadStandardOutput, this, [this, process] {
+        readStatus(process);
+    });
+    connect(process, &QProcess::finished, this, [this, process](int exitCode, QProcess::ExitStatus exitStatus) {
+        finishProcess(process, exitCode, exitStatus);
+    });
+    connect(process, &QProcess::errorOccurred, this, [this, process](QProcess::ProcessError error) {
+        if (process != m_process || error != QProcess::FailedToStart) {
+            return;
+        }
+        m_attemptDeadline.stop();
+        setState(Failed);
+        finishProcess(process, 1, QProcess::CrashExit);
+    });
+
+    m_attemptDeadline.start(attemptLimit);
+    process->start();
+}
+
+void FacePamAuthenticator::cancel()
+{
+    m_pendingActivityAttempt = false;
+    m_activityDeadline.stop();
+    if (!m_process) {
+        if (m_state == Starting || m_state == CameraStarting || m_state == LookingForFace) {
+            m_unlocked = false;
+            setState(Cancelled);
+        }
+        return;
+    }
+    if (m_cancelRequested) {
+        return;
+    }
+
+    m_cancelRequested = true;
+    m_unlocked = false;
+    m_attemptDeadline.stop();
+    setState(Cancelled);
+    terminateProcess();
+}
+
+bool FacePamAuthenticator::registerThemeComponent(QObject *component, int interfaceVersion)
+{
+    if (!component || interfaceVersion != InterfaceV1 || m_workerPath.isEmpty() || !QFileInfo(m_workerPath).isExecutable()) {
+        return false;
+    }
+    if (m_themeComponents.contains(component)) {
+        return true;
+    }
+
+    const bool wasAvailable = isAvailable();
+    m_themeComponents.insert(component);
+    connect(component, &QObject::destroyed, this, [this, component] {
+        const bool wasAvailable = isAvailable();
+        m_themeComponents.remove(component);
+        if (wasAvailable != isAvailable()) {
+            Q_EMIT availableChanged();
+            Q_EMIT canStartChanged();
+        }
+        if (m_themeComponents.isEmpty()) {
+            cancel();
+        }
+    });
+    if (wasAvailable != isAvailable()) {
+        Q_EMIT availableChanged();
+        Q_EMIT canStartChanged();
+    }
+    if (m_policyMode == QLatin1String("on-activity") && m_pendingActivityAttempt) {
+        schedulePendingActivityAttempt();
+    }
+    return true;
+}
+
+void FacePamAuthenticator::notifyUserActivity()
+{
+    if (m_activityAttemptConsumed || m_unlocked) {
+        return;
+    }
+    m_activityAttemptConsumed = true;
+    if (!m_policyReady) {
+        m_pendingActivityAttempt = true;
+        m_activityDeadline.start(policyLookupLimit);
+        return;
+    }
+    if (m_policyMode == QLatin1String("on-activity")) {
+        m_pendingActivityAttempt = true;
+        m_activityDeadline.start(policyLookupLimit);
+        schedulePendingActivityAttempt();
+    }
+}
+
+void FacePamAuthenticator::resetActivityCycle()
+{
+    m_pendingActivityAttempt = false;
+    m_activityAttemptConsumed = false;
+    m_activityDeadline.stop();
+}
+
+void FacePamAuthenticator::startPolicyLookup()
+{
+    if (m_policyHelperPath.isEmpty() || !QFileInfo(m_policyHelperPath).isExecutable() || m_policyUid == 0) {
+        setPolicyMode(QStringLiteral("unknown"));
+        return;
+    }
+
+    auto *process = new QProcess(this);
+    m_policyProcess = process;
+    m_policyOutput.clear();
+    m_policyRejected = false;
+    process->setProgram(m_policyHelperPath);
+    process->setArguments(
+        {QStringLiteral("--get"), QStringLiteral("--uid"), QString::number(m_policyUid), QStringLiteral("--target"), QStringLiteral("plasma-lock")});
+    process->setProcessChannelMode(QProcess::SeparateChannels);
+    QProcessEnvironment environment;
+    environment.insert(QStringLiteral("LANG"), QStringLiteral("C"));
+    environment.insert(QStringLiteral("LC_ALL"), QStringLiteral("C"));
+    environment.insert(QStringLiteral("PATH"), QStringLiteral("/usr/bin:/bin"));
+    process->setProcessEnvironment(environment);
+
+    connect(process, &QProcess::readyReadStandardOutput, this, [this, process] {
+        readPolicyOutput(process);
+    });
+    connect(process, &QProcess::readyReadStandardError, process, [process] {
+        process->readAllStandardError();
+    });
+    connect(process, &QProcess::finished, this, [this, process](int exitCode, QProcess::ExitStatus exitStatus) {
+        finishPolicyLookup(process, exitCode, exitStatus);
+    });
+    connect(process, &QProcess::errorOccurred, this, [this, process](QProcess::ProcessError error) {
+        if (process == m_policyProcess && error == QProcess::FailedToStart) {
+            finishPolicyLookup(process, 1, QProcess::CrashExit);
+        }
+    });
+
+    m_policyDeadline.start(policyLookupLimit);
+    process->start();
+}
+
+void FacePamAuthenticator::readPolicyOutput(QProcess *process)
+{
+    if (process != m_policyProcess || m_policyRejected) {
+        return;
+    }
+    const qsizetype remaining = maximumPolicyOutput + 1 - m_policyOutput.size();
+    m_policyOutput.append(process->read(remaining));
+    if (m_policyOutput.size() > maximumPolicyOutput) {
+        m_policyRejected = true;
+        setPolicyMode(QStringLiteral("unknown"));
+        if (process->state() != QProcess::NotRunning) {
+            process->kill();
+        }
+    }
+}
+
+void FacePamAuthenticator::finishPolicyLookup(QProcess *process, int exitCode, QProcess::ExitStatus exitStatus)
+{
+    if (process != m_policyProcess) {
+        return;
+    }
+    m_policyDeadline.stop();
+    if (!m_policyRejected && m_policyOutput.size() <= maximumPolicyOutput) {
+        const qsizetype remaining = maximumPolicyOutput + 1 - m_policyOutput.size();
+        m_policyOutput.append(process->read(remaining));
+        if (m_policyOutput.size() > maximumPolicyOutput) {
+            m_policyRejected = true;
+        }
+    }
+    m_policyProcess = nullptr;
+    process->deleteLater();
+
+    QString mode = QStringLiteral("unknown");
+    if (!m_policyRejected && m_policyOutput.size() <= maximumPolicyOutput && exitStatus == QProcess::NormalExit && exitCode == 0) {
+        if (m_policyOutput == QByteArrayLiteral("mode=off\n")) {
+            mode = QStringLiteral("off");
+        } else if (m_policyOutput == QByteArrayLiteral("mode=manual\n")) {
+            mode = QStringLiteral("manual");
+        } else if (m_policyOutput == QByteArrayLiteral("mode=on-activity\n")) {
+            mode = QStringLiteral("on-activity");
+        }
+    }
+    m_policyRejected = false;
+    setPolicyMode(mode);
+}
+
+void FacePamAuthenticator::setPolicyMode(const QString &mode)
+{
+    const bool wasAvailable = isAvailable();
+    const bool wasCanStart = canStart();
+    const bool changed = m_policyMode != mode || !m_policyReady;
+    m_policyMode = mode;
+    m_policyReady = true;
+    if (m_policyMode != QLatin1String("on-activity")) {
+        m_pendingActivityAttempt = false;
+        m_activityDeadline.stop();
+    }
+    if (changed) {
+        Q_EMIT policyModeChanged();
+    }
+    if (wasAvailable != isAvailable()) {
+        Q_EMIT availableChanged();
+    }
+    if (wasCanStart != canStart()) {
+        Q_EMIT canStartChanged();
+    }
+    if (m_policyMode == QLatin1String("on-activity") && m_pendingActivityAttempt) {
+        schedulePendingActivityAttempt();
+    }
+}
+
+void FacePamAuthenticator::schedulePendingActivityAttempt()
+{
+    if (m_activityDispatchScheduled) {
+        return;
+    }
+    m_activityDispatchScheduled = true;
+    QTimer::singleShot(0, this, [this] {
+        m_activityDispatchScheduled = false;
+        if (!m_pendingActivityAttempt) {
+            return;
+        }
+        if (m_policyMode != QLatin1String("on-activity")) {
+            m_pendingActivityAttempt = false;
+            m_activityDeadline.stop();
+            return;
+        }
+        if (!canStart()) {
+            return;
+        }
+        m_pendingActivityAttempt = false;
+        m_activityDeadline.stop();
+        startAttempt();
+    });
+}
+
+void FacePamAuthenticator::setState(State state)
+{
+    if (m_state == state) {
+        return;
+    }
+    m_state = state;
+    Q_EMIT stateChanged();
+}
+
+void FacePamAuthenticator::readStatus(QProcess *process)
+{
+    if (process != m_process) {
+        return;
+    }
+    m_statusBuffer.append(process->readAllStandardOutput());
+    if (m_statusBuffer.size() > maximumStatusBuffer) {
+        m_statusBuffer.clear();
+        return;
+    }
+
+    while (true) {
+        const qsizetype newline = m_statusBuffer.indexOf('\n');
+        if (newline < 0) {
+            break;
+        }
+        const QByteArray status = m_statusBuffer.left(newline);
+        m_statusBuffer.remove(0, newline + 1);
+        if (m_cancelRequested || m_state == UsePassword || m_state == CameraBusy
+            || m_state == TimedOut || m_state == ServiceUnavailable || m_state == RetryLater) {
+            continue;
+        }
+        if (status == QByteArrayLiteral("camera-starting")) {
+            setState(CameraStarting);
+        } else if (status == QByteArrayLiteral("looking-for-face")) {
+            setState(LookingForFace);
+        } else if (status == QByteArrayLiteral("camera-busy")) {
+            setState(CameraBusy);
+        } else if (status == QByteArrayLiteral("timeout")) {
+            setState(TimedOut);
+        } else if (status == QByteArrayLiteral("service-unavailable")) {
+            setState(ServiceUnavailable);
+        } else if (status == QByteArrayLiteral("retry-later")) {
+            setState(RetryLater);
+        } else if (status == QByteArrayLiteral("use-password")) {
+            setState(UsePassword);
+        }
+        if (m_state == UsePassword || m_state == CameraBusy || m_state == TimedOut
+            || m_state == ServiceUnavailable || m_state == RetryLater) {
+            m_attemptDeadline.stop();
+            terminateProcess();
+        }
+        // Ignore every other child output value. PAM text never reaches QML.
+    }
+}
+
+void FacePamAuthenticator::finishProcess(QProcess *process, int exitCode, QProcess::ExitStatus exitStatus)
+{
+    if (process != m_process) {
+        return;
+    }
+    m_attemptDeadline.stop();
+    m_killDeadline.stop();
+    readStatus(process);
+    m_process = nullptr;
+    process->deleteLater();
+    Q_EMIT busyChanged();
+    Q_EMIT canStartChanged();
+
+    if (m_cancelRequested) {
+        return;
+    }
+    const bool terminalFailure = m_state == UsePassword || m_state == CameraBusy
+        || m_state == TimedOut || m_state == ServiceUnavailable || m_state == RetryLater;
+    if (exitStatus == QProcess::NormalExit && exitCode == 0 && !terminalFailure) {
+        m_unlocked = true;
+        setState(Succeeded);
+        Q_EMIT succeeded();
+        return;
+    }
+    m_unlocked = false;
+    if (!terminalFailure) {
+        setState(Failed);
+    }
+}
+
+void FacePamAuthenticator::terminateProcess()
+{
+    if (!m_process || m_process->state() == QProcess::NotRunning) {
+        return;
+    }
+    m_process->terminate();
+    m_killDeadline.start(terminateGrace);
+}
diff --git a/greeter/facepamauthenticator.h b/greeter/facepamauthenticator.h
new file mode 100644
index 0000000..a103e48
