index 0000000..95caabe
--- /dev/null
+++ b/greeter/faceautotests/facepamauthenticator_autotest.cpp
@@ -0,0 +1,382 @@
+/*
+    SPDX-FileCopyrightText: 2026 LoofiFaceID contributors
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "../facepamauthenticator.h"
+#include "../facepamstatus.h"
+
+#include <QCoreApplication>
+#include <QElapsedTimer>
+#include <QSignalSpy>
+#include <QTest>
+
+class FacePamAuthenticatorTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void remainsIdleUntilExplicitRequest();
+    void themeInterfaceMustBeLoadedBeforeStarting();
+    void sharedAttemptLivesUntilLastThemeViewDisappears();
+    void onlyPamSuccessUnlocks();
+    void onlyTypedProgressIsExposed();
+    void pamConversationAllowlist_data();
+    void pamConversationAllowlist();
+    void terminalCategoriesSurviveProcessExit_data();
+    void terminalCategoriesSurviveProcessExit();
+    void cancellationStopsWorkerWithoutUnlocking();
+    void cancelledAttemptIgnoresLatePositiveExit();
+    void attemptHasTwoSecondDeadline();
+    void policyOffHidesAndBlocksTheFactor();
+    void manualModeRequiresAnExplicitRequest();
+    void onActivityStartsOnlyOnceUntilTheCycleResets();
+    void activityCanWaitForPolicyLookupButCancellationWins();
+    void activityExpiresWhenThemeSupportDoesNotResolve();
+    void policyLookupFailsClosedOnInvalidOutputAndTimeout();
+};
+
+static QString fixturePath()
+{
+    return QCoreApplication::applicationDirPath() + QStringLiteral("/facePamWorkerFixture");
+}
+
+static QString policyHelperPath()
+{
+    return QCoreApplication::applicationDirPath() + QStringLiteral("/facePolicyHelperFixture");
+}
+
+static void waitForMode(FacePamAuthenticator &authenticator, const QString &mode)
+{
+    if (mode == QLatin1String("unknown")) {
+        QSignalSpy resolved(&authenticator, &FacePamAuthenticator::policyModeChanged);
+        QTRY_VERIFY_WITH_TIMEOUT(!resolved.isEmpty(), 1000);
+    } else {
+        QTRY_COMPARE_WITH_TIMEOUT(authenticator.policyMode(), mode, 1000);
+    }
+    QCOMPARE(authenticator.policyMode(), mode);
+}
+
+static void registerManualTheme(FacePamAuthenticator &authenticator, QObject *theme)
+{
+    waitForMode(authenticator, QStringLiteral("manual"));
+    QVERIFY(authenticator.registerThemeComponent(theme, FacePamAuthenticator::InterfaceV1));
+}
+
+void FacePamAuthenticatorTest::remainsIdleUntilExplicitRequest()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("block"), fixturePath(), QString(), 1000);
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+    QVERIFY(!authenticator.isBusy());
+    QVERIFY(!authenticator.isAvailable());
+    QVERIFY(!authenticator.canStart());
+    QVERIFY(!authenticator.isUnlocked());
+}
+
+void FacePamAuthenticatorTest::themeInterfaceMustBeLoadedBeforeStarting()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1002);
+    QObject wrongThemeComponent;
+    QObject themeComponent;
+    waitForMode(authenticator, QStringLiteral("manual"));
+
+    QVERIFY(!authenticator.registerThemeComponent(&wrongThemeComponent, 99));
+    authenticator.startAttempt();
+    QTest::qWait(100);
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+
+    registerManualTheme(authenticator, &themeComponent);
+    QVERIFY(authenticator.isAvailable());
+    QVERIFY(authenticator.canStart());
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::Succeeded, 1500);
+}
+
+void FacePamAuthenticatorTest::sharedAttemptLivesUntilLastThemeViewDisappears()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("block"), fixturePath(), policyHelperPath(), 1002);
+    auto *firstScreenComponent = new QObject;
+    auto *secondScreenComponent = new QObject;
+    waitForMode(authenticator, QStringLiteral("manual"));
+    QVERIFY(authenticator.registerThemeComponent(firstScreenComponent, FacePamAuthenticator::InterfaceV1));
+    QVERIFY(authenticator.registerThemeComponent(secondScreenComponent, FacePamAuthenticator::InterfaceV1));
+
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::CameraStarting, 1000);
+    delete firstScreenComponent;
+    QVERIFY(authenticator.isAvailable());
+    QVERIFY(authenticator.isBusy());
+
+    delete secondScreenComponent;
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Cancelled);
+    QVERIFY(!authenticator.isAvailable());
+    QVERIFY(!authenticator.isUnlocked());
+    QTRY_VERIFY_WITH_TIMEOUT(!authenticator.isBusy(), 1000);
+}
+
+void FacePamAuthenticatorTest::onlyPamSuccessUnlocks()
+{
+    FacePamAuthenticator success(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1002);
+    QObject successTheme;
+    registerManualTheme(success, &successTheme);
+    QSignalSpy successSpy(&success, &FacePamAuthenticator::succeeded);
+    success.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(success.state(), FacePamAuthenticator::Succeeded, 1500);
+    QCOMPARE(successSpy.count(), 1);
+    QVERIFY(success.isUnlocked());
+
+    FacePamAuthenticator failure(QStringLiteral("failure"), fixturePath(), policyHelperPath(), 1002);
+    QObject failureTheme;
+    registerManualTheme(failure, &failureTheme);
+    failure.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(failure.state(), FacePamAuthenticator::UsePassword, 1000);
+    QTRY_VERIFY_WITH_TIMEOUT(!failure.isBusy(), 1500);
+    QCOMPARE(failure.state(), FacePamAuthenticator::UsePassword);
+    QVERIFY(!failure.isUnlocked());
+}
+
+void FacePamAuthenticatorTest::onlyTypedProgressIsExposed()
+{
+    FacePamAuthenticator progress(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1002);
+    QObject progressTheme;
+    registerManualTheme(progress, &progressTheme);
+    progress.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(progress.state(), FacePamAuthenticator::CameraStarting, 1000);
+    QTRY_COMPARE_WITH_TIMEOUT(progress.state(), FacePamAuthenticator::LookingForFace, 1000);
+    QTRY_COMPARE_WITH_TIMEOUT(progress.state(), FacePamAuthenticator::Succeeded, 1500);
+
+    FacePamAuthenticator untrusted(QStringLiteral("untrusted"), fixturePath(), policyHelperPath(), 1002);
+    QObject untrustedTheme;
+    registerManualTheme(untrusted, &untrustedTheme);
+    untrusted.startAttempt();
+    QTRY_VERIFY_WITH_TIMEOUT(untrusted.isBusy(), 500);
+    QTest::qWait(100);
+    QCOMPARE(untrusted.state(), FacePamAuthenticator::Starting);
+    untrusted.cancel();
+    QTRY_VERIFY_WITH_TIMEOUT(untrusted.canStart(), 1000);
+}
+
+void FacePamAuthenticatorTest::pamConversationAllowlist_data()
+{
+    QTest::addColumn<QByteArray>("message");
+    QTest::addColumn<QByteArray>("token");
+    QTest::newRow("starting-camera") << QByteArray("KFACEAUTH_STATUS=starting-camera") << QByteArray("camera-starting");
+    for (const char *value : {"looking-for-face", "use-password", "camera-busy", "timeout", "service-unavailable", "retry-later"}) {
+        QTest::newRow(value) << QByteArray("KFACEAUTH_STATUS=") + value << QByteArray(value);
+    }
+    QTest::newRow("unknown") << QByteArray("KFACEAUTH_STATUS=accepted") << QByteArray();
+    QTest::newRow("raw-text") << QByteArray("untrusted text") << QByteArray();
+    QTest::newRow("leading-space") << QByteArray(" KFACEAUTH_STATUS=timeout") << QByteArray();
+    QTest::newRow("trailing-newline") << QByteArray("KFACEAUTH_STATUS=timeout\n") << QByteArray();
+}
+
+void FacePamAuthenticatorTest::pamConversationAllowlist()
+{
+    QFETCH(QByteArray, message);
+    QFETCH(QByteArray, token);
+    QCOMPARE(QByteArray(facePamStatusToken(message.constData())), token);
+    QVERIFY(facePamStatusToken(nullptr) == nullptr);
+}
+
+void FacePamAuthenticatorTest::terminalCategoriesSurviveProcessExit_data()
+{
+    QTest::addColumn<QString>("token");
+    QTest::addColumn<int>("state");
+    QTest::newRow("camera-busy") << QStringLiteral("camera-busy") << int(FacePamAuthenticator::CameraBusy);
+    QTest::newRow("timeout") << QStringLiteral("timeout") << int(FacePamAuthenticator::TimedOut);
+    QTest::newRow("service-unavailable") << QStringLiteral("service-unavailable") << int(FacePamAuthenticator::ServiceUnavailable);
+    QTest::newRow("retry-later") << QStringLiteral("retry-later") << int(FacePamAuthenticator::RetryLater);
+    QTest::newRow("use-password") << QStringLiteral("use-password") << int(FacePamAuthenticator::UsePassword);
+}
+
+void FacePamAuthenticatorTest::terminalCategoriesSurviveProcessExit()
+{
+    QFETCH(QString, token);
+    QFETCH(int, state);
+    for (const QString &suffix : {QString(), QStringLiteral("-late-success")}) {
+        FacePamAuthenticator authenticator(token + suffix, fixturePath(), policyHelperPath(), 1002);
+        QObject theme;
+        registerManualTheme(authenticator, &theme);
+        QSignalSpy successes(&authenticator, &FacePamAuthenticator::succeeded);
+        authenticator.startAttempt();
+        QTRY_VERIFY_WITH_TIMEOUT(!authenticator.isBusy(), 1500);
+        QCOMPARE(int(authenticator.state()), state);
+        QCOMPARE(successes.count(), 0);
+        QVERIFY(!authenticator.isUnlocked());
+        QVERIFY(authenticator.canStart());
+    }
+}
+
+void FacePamAuthenticatorTest::cancellationStopsWorkerWithoutUnlocking()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("block"), fixturePath(), policyHelperPath(), 1002);
+    QObject themeComponent;
+    registerManualTheme(authenticator, &themeComponent);
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::CameraStarting, 1000);
+
+    QElapsedTimer timer;
+    timer.start();
+    authenticator.cancel();
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Cancelled);
+    QVERIFY(timer.elapsed() < 250);
+    QVERIFY(!authenticator.isUnlocked());
+    QTRY_VERIFY_WITH_TIMEOUT(authenticator.canStart(), 1000);
+}
+
+void FacePamAuthenticatorTest::cancelledAttemptIgnoresLatePositiveExit()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("late-success"), fixturePath(), policyHelperPath(), 1002);
+    QObject themeComponent;
+    registerManualTheme(authenticator, &themeComponent);
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::CameraStarting, 1000);
+    authenticator.cancel();
+    QTRY_VERIFY_WITH_TIMEOUT(authenticator.canStart(), 1000);
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Cancelled);
+    QVERIFY(!authenticator.isUnlocked());
+}
+
+void FacePamAuthenticatorTest::attemptHasTwoSecondDeadline()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("block"), fixturePath(), policyHelperPath(), 1002);
+    QObject themeComponent;
+    registerManualTheme(authenticator, &themeComponent);
+    QElapsedTimer timer;
+    timer.start();
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::TimedOut, 2500);
+    QVERIFY(timer.elapsed() >= 1800);
+    QVERIFY(timer.elapsed() < 2400);
+    QVERIFY(!authenticator.isUnlocked());
+    QTRY_VERIFY_WITH_TIMEOUT(authenticator.canStart(), 1000);
+}
+
+void FacePamAuthenticatorTest::policyOffHidesAndBlocksTheFactor()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1001);
+    waitForMode(authenticator, QStringLiteral("off"));
+    QObject theme;
+    QVERIFY(authenticator.registerThemeComponent(&theme, FacePamAuthenticator::InterfaceV1));
+    QVERIFY(!authenticator.isAvailable());
+    QVERIFY(!authenticator.canStart());
+
+    authenticator.notifyUserActivity();
+    authenticator.startAttempt();
+    QTest::qWait(100);
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+}
+
+void FacePamAuthenticatorTest::manualModeRequiresAnExplicitRequest()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1002);
+    QObject theme;
+    registerManualTheme(authenticator, &theme);
+
+    authenticator.notifyUserActivity();
+    QTest::qWait(100);
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+
+    authenticator.startAttempt();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::Succeeded, 1500);
+}
+
+void FacePamAuthenticatorTest::onActivityStartsOnlyOnceUntilTheCycleResets()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("failure"), fixturePath(), policyHelperPath(), 1003);
+    waitForMode(authenticator, QStringLiteral("on-activity"));
+    QObject theme;
+    QVERIFY(authenticator.registerThemeComponent(&theme, FacePamAuthenticator::InterfaceV1));
+    QSignalSpy busySpy(&authenticator, &FacePamAuthenticator::busyChanged);
+    QTest::qWait(100);
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+    QVERIFY(!authenticator.isBusy());
+
+    authenticator.notifyUserActivity();
+    authenticator.notifyUserActivity();
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::UsePassword, 1500);
+    QTRY_VERIFY_WITH_TIMEOUT(!authenticator.isBusy(), 1500);
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(busySpy.count(), 2);
+
+    authenticator.notifyUserActivity();
+    QTest::qWait(100);
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::UsePassword);
+
+    authenticator.resetActivityCycle();
+    authenticator.notifyUserActivity();
+    QTRY_VERIFY_WITH_TIMEOUT(busySpy.count() >= 3, 1000);
+    QTRY_COMPARE_WITH_TIMEOUT(authenticator.state(), FacePamAuthenticator::UsePassword, 1500);
+    QTRY_VERIFY_WITH_TIMEOUT(!authenticator.isBusy(), 1500);
+}
+
+void FacePamAuthenticatorTest::activityCanWaitForPolicyLookupButCancellationWins()
+{
+    FacePamAuthenticator pending(QStringLiteral("block"), fixturePath(), policyHelperPath(), 1007);
+    QObject pendingTheme;
+    QVERIFY(pending.registerThemeComponent(&pendingTheme, FacePamAuthenticator::InterfaceV1));
+    pending.notifyUserActivity();
+    QTRY_COMPARE_WITH_TIMEOUT(pending.state(), FacePamAuthenticator::CameraStarting, 1000);
+    pending.cancel();
+    QTRY_VERIFY_WITH_TIMEOUT(!pending.isBusy(), 1000);
+    QVERIFY(!pending.isUnlocked());
+
+    FacePamAuthenticator cancelled(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1007);
+    cancelled.notifyUserActivity();
+    cancelled.cancel();
+    QObject cancelledTheme;
+    QVERIFY(cancelled.registerThemeComponent(&cancelledTheme, FacePamAuthenticator::InterfaceV1));
+    waitForMode(cancelled, QStringLiteral("on-activity"));
+    QTest::qWait(150);
+    QVERIFY(!cancelled.isBusy());
+    QCOMPARE(cancelled.state(), FacePamAuthenticator::Idle);
+}
+
+void FacePamAuthenticatorTest::activityExpiresWhenThemeSupportDoesNotResolve()
+{
+    FacePamAuthenticator authenticator(QStringLiteral("block"), fixturePath(), policyHelperPath(), 1003);
+    authenticator.notifyUserActivity();
+    waitForMode(authenticator, QStringLiteral("on-activity"));
+    QTest::qWait(300);
+
+    QObject theme;
+    QVERIFY(authenticator.registerThemeComponent(&theme, FacePamAuthenticator::InterfaceV1));
+    QVERIFY(authenticator.isAvailable());
+    QVERIFY(!authenticator.isBusy());
+    QCOMPARE(authenticator.state(), FacePamAuthenticator::Idle);
+
+    authenticator.resetActivityCycle();
+    authenticator.notifyUserActivity();
+    QTRY_VERIFY_WITH_TIMEOUT(authenticator.isBusy(), 1000);
+    authenticator.cancel();
+}
+
+void FacePamAuthenticatorTest::policyLookupFailsClosedOnInvalidOutputAndTimeout()
+{
+    FacePamAuthenticator extraOutput(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1004);
+    waitForMode(extraOutput, QStringLiteral("unknown"));
+    QObject extraOutputTheme;
+    QVERIFY(extraOutput.registerThemeComponent(&extraOutputTheme, FacePamAuthenticator::InterfaceV1));
+    QVERIFY(!extraOutput.isAvailable());
+
+    FacePamAuthenticator nonzero(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1005);
+    waitForMode(nonzero, QStringLiteral("unknown"));
+    QVERIFY(!nonzero.isAvailable());
+
+    FacePamAuthenticator timeout(QStringLiteral("success"), fixturePath(), policyHelperPath(), 1006);
+    QElapsedTimer timer;
+    timer.start();
+    waitForMode(timeout, QStringLiteral("unknown"));
+    QVERIFY(timer.elapsed() < 500);
+    QVERIFY(!timeout.isAvailable());
+
+    FacePamAuthenticator missing(QStringLiteral("success"), fixturePath(), QStringLiteral("/no/such/kfaceauth-policy"), 1002);
+    QCOMPARE(missing.policyMode(), QStringLiteral("unknown"));
+    QVERIFY(!missing.isAvailable());
+}
+
+QTEST_GUILESS_MAIN(FacePamAuthenticatorTest)
+#include "facepamauthenticator_autotest.moc"
