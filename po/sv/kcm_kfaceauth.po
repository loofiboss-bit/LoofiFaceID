#: src/backend/visionanalysissession.cpp:44
msgid "VisionAnalysisSession"
msgstr "VisionAnalysisSession"

#: src/backend/visionanalysissession.cpp:96
msgid "Analyze one current preview frame when you choose."
msgstr "Analysera en aktuell förhandsvisningsruta när du själv väljer."

#: src/backend/visionanalysissession.cpp:315
msgid "Replacing the previous analysis with the current frame…"
msgstr "Ersätter den föregående analysen med den aktuella bildrutan…"

#: src/backend/visionanalysissession.cpp:316
msgid "Analysis was cancelled and its in-memory data was cleared."
msgstr "Analysen avbröts och dess data i minnet rensades."

#: src/backend/visionanalysissession.cpp:341
msgid "Analyzing one in-memory frame…"
msgstr "Analyserar en bildruta i minnet…"

#: src/backend/visionanalysissession.cpp:388
msgid "Starting local vision analysis…"
msgstr "Startar lokal bildanalys…"

#: src/backend/visionanalysissession.cpp:436
msgid "Finishing local analysis and clearing process data…"
msgstr "Slutför lokal analys och rensar processdata…"

#: src/backend/visionanalysissession.cpp:471
msgid "One-frame analysis is complete. No image was saved."
msgstr "Analysen av en bildruta är klar. Ingen bild sparades."

#: src/backend/visionanalysissession.cpp:620
msgid "Local vision analysis could not be started."
msgstr "Den lokala bildanalysen kunde inte startas."

#: src/backend/visionanalysissession.cpp:622
msgid "Local vision analysis did not start in time."
msgstr "Den lokala bildanalysen startade inte i tid."

#: src/backend/visionanalysissession.cpp:624
msgid "The one-frame analysis timed out."
msgstr "Tidsgränsen för analysen av en bildruta överskreds."

#: src/backend/visionanalysissession.cpp:626
msgid "Local vision analysis did not stop cleanly."
msgstr "Den lokala bildanalysen stoppades inte korrekt."

#: src/backend/visionanalysissession.cpp:628
msgid "Local vision analysis stopped unexpectedly."
msgstr "Den lokala bildanalysen stoppades oväntat."

#: src/backend/visionanalysissession.cpp:630
msgid "An outdated analysis response was rejected."
msgstr "Ett inaktuellt analyssvar avvisades."

#: src/backend/visionanalysissession.cpp:632
msgid "The current preview frame could not be analyzed."
msgstr "Den aktuella förhandsvisningsrutan kunde inte analyseras."

#: src/backend/visionanalysissession.cpp:634
msgid ""
"YuNet is unavailable or failed model verification. Reinstall KFaceAuth and "
"try again."
msgstr ""
"YuNet är inte tillgängligt eller klarade inte modellverifieringen. "
"Installera om KFaceAuth och försök igen."

#: src/backend/visionanalysissession.cpp:636
msgid ""
"The local YuNet detector returned invalid data. Try another frame or "
"reinstall OpenCV."
msgstr ""
"Den lokala YuNet-detektorn returnerade ogiltiga data. Försök med en annan "
"bildruta eller installera om OpenCV."

#: src/backend/visionanalysissession.cpp:638
msgid "Local vision analysis could not process this frame."
msgstr "Den lokala bildanalysen kunde inte bearbeta den här bildrutan."

#: src/backend/visionanalysissession.cpp:639
msgid "Local vision analysis returned invalid data."
msgstr "Den lokala bildanalysen returnerade ogiltiga data."

